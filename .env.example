# =============================================================================
# FairShift Environment Configuration Template
# Prompt Wars 2026 | Google Cloud Run Deployment Guide
# =============================================================================

# Server Port (Cloud Run dynamically sets $PORT; defaults to 8080)
PORT=8080

# Environment Mode: 'development' or 'production'
NODE_ENV=development

# Cryptographic Session Secret for HMAC Token Verification
# In production, replace with a 64+ char random string
SESSION_SECRET=fairshift-secure-dev-session-secret-change-in-prod

# -----------------------------------------------------------------------------
# Database Persistence Configuration:
# - Local Development: Leave DATABASE_URL blank or commented out.
#   FairShift will use atomic local persistence (SQLite / JSON store).
# - Production Google Cloud Run: Set DATABASE_URL to a managed PostgreSQL
#   connection string (e.g., Google Cloud SQL PostgreSQL instance).
#   Cloud Run container filesystems are ephemeral, so external persistence is required.
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://fairshift_user:STRONG_PASSWORD@/fairshift?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
# DATABASE_URL=postgresql://user:password@pg-host.provider.com:5432/fairshift?sslmode=require
